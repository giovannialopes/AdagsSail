{
  "name": "adagssail",
  "productName": "AdagsSail",
  "version": "1.4.0",
  "description": "Overlay que avalia as cartas (Seal Whispers) do Blacksail no Torchlight: Infinite SS14",
  "main": "out/main.js",
  "author": "Giovanni",
  "license": "MIT",
  "private": true,
  "scripts": {
    "build": "tsc --noEmit && node build.mjs",
    "dev": "npm run build && electron .",
    "test": "vitest run",
    "dist": "npm run build && electron-builder --win portable",
    "selftest": "node build.mjs --selftest && electron out/selftest.js"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@tesseract.js-data/eng": "^1.0.0",
    "koffi": "^3.3.3",
    "tesseract.js": "^7.0.0"
  },
  "build": {
    "appId": "tech.adags.adagssail",
    "productName": "AdagsSail",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/main.js",
      "out/preload.js",
      "out/renderer/**/*",
      "!out/**/*.map",
      "build/icon.png",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/**"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "portable": {
      "artifactName": "AdagsSail-${version}-portable.exe"
    }
  }
}
